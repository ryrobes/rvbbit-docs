{
  "name": "rvbbit-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check:sources": "node scripts/check-source-docs.mjs",
    "deploy:gcp": "bash scripts/deploy-gcp.sh",
    "benchmarks:export": "node scripts/export-large-bench.mjs",
    "capabilities:export": "node scripts/export-capabilities-catalog.mjs",
    "clover:sync": "node scripts/sync-clover-catalog.mjs && npm run capabilities:export && npm run prebuild",
    "prebuild": "node scripts/gen-clover-install.mjs && node scripts/gen-clover-operators.mjs",
    "agents:gen": "node scripts/gen-clover-install.mjs",
    "og:gen": "node scripts/gen-og-images.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^3.15.0",
    "lucide-react": "^0.511.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@types/node": "^22.15.24",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "playwright-core": "^1.61.1",
    "typescript": "^5.8.3"
  }
}
